# Copiar a .env (nunca commitear valores reales)
NODE_ENV=development
PORT=3006
# Conexion con pooling para runtime (Neon pooled + ?pgbouncer=true)
DATABASE_URL=postgresql://usuario:password@host:5432/housekeeping_db?sslmode=require
# Conexion directa SIN pooling, solo para `prisma migrate deploy`
DIRECT_URL=postgresql://usuario:password@host:5432/housekeeping_db?sslmode=require
# URL base del booking-service (ej. https://xxx.onrender.com/v1)
BOOKING_SERVICE_URL=http://localhost:3004/v1
# RabbitMQ (CloudAMQP). Vacio = eventos deshabilitados, el servicio arranca igual.
RABBITMQ_URL=
# Solo para seed de demo
SEED_HOTEL_ID=
SEED_ROOM_NUMBERS=

# HS256 compartido con user-service (min 32 chars)
AUTH_JWT_SECRET=

# Debe coincidir con HOUSEKEEPING_SERVICE_KEY de Booking (header x-housekeeping-key)
BOOKING_SERVICE_KEY=

# Requerido: sin esto la asignacion de tareas falla cerrado
USER_SERVICE_URL=http://localhost:3003/v1
