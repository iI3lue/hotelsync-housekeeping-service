generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Estado de cada habitación física por hotel (HK-1, documento de
 * arquitectura §5.6). La fila nace con el primer checkout de esa
 * habitación; el estado manual (maintenance) se gestiona por API.
 * Sin FK entre bases: hotel_id es solo el UUID de Property.
 * `assigned_to` queda nullable en la práctica: una habitación sucia sin
 * personal asignado existe en el flujo real (el doc lo pide NOT NULL,
 * pero eso obligaría a inventar valores).
 */
model RoomStatus {
  room_status_id   String   @id @default(uuid()) @db.Uuid
  hotel_id         String   @db.Uuid
  physical_room_id String?  @db.Uuid
  room_number      String   @db.VarChar(20)
  status           String   @default("clean") @db.VarChar(20)
  assigned_to      String?  @db.VarChar(100)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  history CleaningHistory[]

  @@unique([hotel_id, room_number])
  @@index([hotel_id, status])
  @@map("room_status")
}

/**
 * Historial de tareas de limpieza (HK-2, HK-3, documento de arquitectura
 * §5.6). Cada fila es una tarea con su ciclo de vida.
 * `booking_id` es la clave de idempotencia: un checkout genera una sola
 * tarea aunque el broker redeliveree `checkout.completed`.
 */
model CleaningHistory {
  history_id           String    @id @default(uuid()) @db.Uuid
  room_status_id       String    @db.Uuid
  booking_id           String    @unique @db.Uuid
  hotel_id             String    @db.Uuid
  physical_room_id     String?   @db.Uuid
  room_number          String    @db.VarChar(20)
  status               String    @default("pending") @db.VarChar(20)
  assigned_to          String?   @db.VarChar(100)
  assigned_to_user_id  String?   @db.Uuid
  completed_by_user_id String?   @db.Uuid
  completed_at         DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @updatedAt @db.Timestamptz(6)

  roomStatus RoomStatus @relation(fields: [room_status_id], references: [room_status_id], onDelete: Cascade)

  @@index([hotel_id, status])
  @@index([booking_id])
  @@index([assigned_to_user_id])
  @@map("cleaning_history")
}
